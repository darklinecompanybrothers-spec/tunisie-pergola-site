# Tunisie Pergola — en-têtes HTTP
# ================================
# Format Cloudflare Pages / Netlify. L'équivalent Vercel est dans `vercel.json`
# à la racine du projet : les deux déclarent exactement la même politique.
#
# La CSP est stricte parce que le site peut se le permettre : aucun script en
# ligne, aucune feuille de style en ligne, aucun attribut `style=`, aucun CDN,
# aucun traceur. `scripts/audit-build.mjs` vérifie à chaque build que le HTML
# produit respecte encore ces directives — si quelqu'un ajoute un `<style>` ou
# un `onclick`, le build échoue avant que la CSP ne casse la page en production.
#
# Deux ouvertures, et deux seulement, toutes deux vers le circuit de réception
# DCB déjà utilisé par le site DCB :
#   • connect-src  → l'envoi du formulaire en JavaScript (fetch);
#   • form-action  → l'envoi du formulaire sans JavaScript (POST natif).

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://docs.google.com; connect-src 'self' https://docs.google.com; img-src 'self'; font-src 'self'; style-src 'self'; script-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()

# Empreintes de contenu dans le nom du fichier : cache définitif.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Les fichiers de marque changent avec la validation client : cache court.
/brand/*
  Cache-Control: public, max-age=3600, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
