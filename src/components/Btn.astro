---
/**
 * Le contrôle principal du site — « la lame ».
 *
 * Ce n'est pas un rectangle qui change de couleur. Au repos, une plaque posée
 * sur une lèvre d'ombre décalée. Au survol et au focus clavier, six lames de
 * pergola se referment de gauche à droite sur la plaque, l'étiquette passe sur
 * l'autre encre et la flèche s'allonge. À l'activation, la lèvre se rétracte :
 * le bouton s'enfonce réellement dans la page.
 *
 * Six lames, pas cinq : c'est le nombre exact du monogramme. Le composant
 * existe pour que ce détail — et les cinq états — ne puissent pas diverger d'un
 * bouton à l'autre.
 *
 * `href` produit un lien, `type` un bouton. Aucun des deux ensemble.
 *
 * `glyph` pose un pictogramme de canal AVANT l'étiquette. Un seul existe —
 * WhatsApp — et il n'est pas là pour décorer : un bouton qui fait quitter le
 * site doit annoncer où il mène avant qu'on clique. Le glyphe se reconnaît
 * plus vite que le mot ne se lit.
 */
import GlyphWhatsapp from './GlyphWhatsapp.astro';
import { type Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  href?: string | undefined;
  type?: 'submit' | 'button' | undefined;
  tone?: 'primary' | 'ghost' | 'quiet';
  /** Pictogramme de canal, posé avant l'étiquette. */
  glyph?: 'whatsapp' | undefined;
  /** Ouvre dans un nouvel onglet — ajoute le `rel` et la mention lecteur d'écran. */
  external?: boolean | undefined;
  /**
   * Langue de la mention « nouvel onglet ».
   *
   * Elle est annoncée aux lecteurs d'écran, donc elle doit être dans la langue
   * de la page : une page arabe qui dirait « (nouvel onglet) » en français
   * ferait basculer la voix de synthèse au milieu d’un libellé. Le français
   * reste le défaut, ce qui laisse intacts les appels qui ne la passent pas.
   */
  locale?: Locale | undefined;
  /** Valeur de `data-track`, lue par le suivi d'origine des demandes. */
  track?: string | undefined;
  /** Attribut de repérage utilisé par le script du formulaire. */
  submitHook?: boolean | undefined;
  class?: string | undefined;
  'aria-label'?: string | undefined;
}

const {
  href,
  type,
  tone = 'primary',
  glyph,
  external = false,
  locale = 'fr',
  track,
  submitHook = false,
  class: className,
  'aria-label': ariaLabel
} = Astro.props;

if (!href && !type) {
  throw new Error('Btn.astro — il faut soit `href` (lien) soit `type` (bouton).');
}

const BLADES = [0, 1, 2, 3, 4, 5];
const classes = ['tp-btn', `tp-btn--${tone}`, glyph && `tp-btn--${glyph}`, className];
---

{
  href ? (
    <a
      class:list={classes}
      href={href}
      data-track={track}
      aria-label={ariaLabel}
      rel={external ? 'noopener noreferrer' : undefined}
      target={external ? '_blank' : undefined}
    >
      <span class="tp-btn__blades" aria-hidden="true">
        {BLADES.map(() => (
          <span />
        ))}
      </span>
      {glyph === 'whatsapp' && <GlyphWhatsapp class="tp-btn__glyph" />}
      <span class="tp-btn__label">
        <slot />
      </span>
      <span class="tp-btn__arrow" aria-hidden="true" />
      {external && <span class="tp-visually-hidden">{ui('newTab', locale)}</span>}
    </a>
  ) : (
    <button class:list={classes} type={type} aria-label={ariaLabel} data-submit={submitHook ? '' : undefined}>
      <span class="tp-btn__blades" aria-hidden="true">
        {BLADES.map(() => (
          <span />
        ))}
      </span>
      {glyph === 'whatsapp' && <GlyphWhatsapp class="tp-btn__glyph" />}
      <span class="tp-btn__label">
        <slot />
      </span>
      <span class="tp-btn__arrow" aria-hidden="true" />
    </button>
  )
}
