---
/**
 * Canaux directs. Le formulaire reste le canal principal, mais un visiteur
 * pressé doit pouvoir appeler ou écrire sans remplir quoi que ce soit.
 * Un seul numéro, celui de la fiche publique, pour l'appel comme pour WhatsApp.
 */
import { SITE } from '../data/site';
import type { Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Ajoute l'adresse postale sous les canaux joignables. */
  withAddress?: boolean | undefined;
}

const { locale, withAddress = false } = Astro.props;
---

<div class="tp-cta__channels">
  <a class="tp-channel" href={SITE.contact.phoneHref} data-track="phone">
    <span>{ui('channelCall', locale)}</span>
    <span class="tp-tabular tp-ltr">{SITE.contact.phoneDisplay}</span>
  </a>

  <a
    class="tp-channel"
    href={SITE.contact.whatsappHref}
    rel="noopener noreferrer"
    target="_blank"
    data-track="whatsapp"
  >
    <span>{ui('channelWhatsapp', locale)}</span>
    <span class="tp-tabular tp-ltr"
      >{SITE.contact.phoneDisplay}<span class="tp-visually-hidden">{ui('newTab', locale)}</span></span
    >
  </a>

  <a class="tp-channel" href={SITE.contact.emailHref}>
    <span>{ui('channelEmail', locale)}</span>
    <span class="tp-ltr">{SITE.contact.email}</span>
  </a>

  {
    withAddress && (
      <p class="tp-channel">
        <span>{ui('channelAddress', locale)}</span>
        <span>{SITE.address.inline[locale]}</span>
      </p>
    )
  }
</div>
