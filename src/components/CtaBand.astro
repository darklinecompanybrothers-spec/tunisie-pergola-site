---
/**
 * Bande de conversion des pages internes. Un seul appel à l'action principal
 * par scène, doublé des canaux directs — le formulaire complet reste sur
 * l'accueil et sur la page contact.
 */
import ContactChannels from './ContactChannels.astro';
import Btn from './Btn.astro';
import { SITE } from '../data/site';
import { localePath, type Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string | undefined;
  text?: string | undefined;
}

const { locale, title, text } = Astro.props;
---

<section class="tp-scene tp-dark" aria-labelledby="tp-cta-titre">
  <div class="tp-shell tp-cta">
    <div class="tp-stack">
      <p class="tp-eyebrow">{ui('eyebrowYourProject', locale)}</p>
      <h2 class="tp-cta__title tp-mask" id="tp-cta-titre">{title ?? ui('ctaTitle', locale)}</h2>
      <p class="tp-lede">{text ?? ui('ctaText', locale)}</p>
      <div class="tp-actions">
        <Btn href={localePath('/contact/', locale)}>{ui('ctaProject', locale)}</Btn>
      </div>
      <p class="tp-text-soft">{SITE.responsePromise[locale]}.</p>
    </div>

    <ContactChannels locale={locale} />
  </div>
</section>
