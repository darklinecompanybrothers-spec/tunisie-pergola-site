---
/**
 * La planche — les onze familles d'ouvrages.
 * ==========================================
 *
 * CE QUI A ÉTÉ REMPLACÉ, ET POURQUOI
 * Cette scène présentait trois familles derrière une plaque de verre : une
 * colonne de noms défilait, `backdrop-filter` floutait tout sauf le nom cadré
 * par une baie. C'était le plus beau moment de la page et le plus coûteux —
 * une scène épinglée de trois écrans de haut qui recomposait un flou plein
 * cadre à chaque image, sur le profil mobile précisément mis en cause par le
 * client. Elle ne passait pas non plus à onze familles : le même mécanisme y
 * aurait demandé onze crans, donc onze écrans de défilement pour lire un
 * sommaire.
 *
 * Ce qui la remplace n'est pas un repli : c'est une PLANCHE DE FABRICATION.
 * Onze élévations au trait, numérotées, alignées sur une trame — ce que l'on
 * punaise dans un atelier avant de découper. Chaque case dit son numéro, son
 * dessin, son nom et son nombre d'ouvrages. On la lit d'un regard, elle tient
 * sur un téléphone, et son seul mouvement — le trait qui se dessine à
 * l'apparition — coûte une animation de `stroke-dashoffset` sur un SVG de
 * quelques centaines d'octets.
 *
 * CE QUI EST RÉEL
 * Tout. Onze liens, onze noms, onze nombres — présents dans le HTML, dans
 * l'ordre, atteignables au clavier, lisibles par un moteur. Aucun contenu
 * n'est réservé au survol ni à une position de défilement.
 */
import Motif from './Motif.astro';
import Btn from './Btn.astro';
import { FAMILIES } from '../data/catalogue';
import { localePath, type Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="tp-scene tp-board tp-light tp-scene--ruled" aria-labelledby="tp-familles">
  <div class="tp-shell tp-stack tp-stack--lg">
    <div class="tp-grid">
      <div class="tp-stack tp-span-lede">
        <p class="tp-eyebrow">{ui('familiesEyebrow', locale)}</p>
        <h2 class="tp-mask" id="tp-familles">{ui('familiesTitle', locale)}</h2>
      </div>
      <p class="tp-lede tp-reveal tp-span-body">{ui('familiesLede', locale)}</p>
    </div>

    <ul class="tp-board__grid tp-stagger" role="list">
      {
        FAMILIES.map((family) => (
          <li class="tp-reveal">
            <a class="tp-board__card" href={localePath(family.route, locale)}>
              <span class="tp-board__n">{family.index}</span>
              <Motif motif={family.motif} class="tp-board__motif" />
              <span class="tp-board__nom">{family.nom[locale]}</span>
              <span class="tp-board__count">
                {family.products.length}&nbsp;{ui('countWorks', locale)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p><Btn href={localePath('/ouvrages-metalliques/', locale)} tone="quiet">{ui('ctaCatalogue', locale)}</Btn></p>
  </div>
</section>
