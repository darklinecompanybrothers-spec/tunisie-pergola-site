---
/**
 * Formulaire de projet → circuit de réception DCB.
 *
 * Sans JavaScript, c'est un formulaire HTML ordinaire qui poste directement
 * vers le formulaire DCB vérifié : les champs portant un identifiant `entry.*`
 * partent, la validation native s'applique, rien n'est mort. Avec JavaScript,
 * l'envoi devient discret, la liste des ouvrages se restreint à la famille
 * choisie, les champs de qualification sont repliés dans le champ de détails,
 * et l'erreur reste sur la page avec les valeurs saisies.
 *
 * QUALIFIER PARMI CINQUANTE OUVRAGES
 * Le prospect choisit d'abord une FAMILLE, puis un OUVRAGE. Les deux listes
 * sont écrites en entier dans le HTML — les cinquante ouvrages sont donc
 * présents et groupés par famille même sans JavaScript, et le script ne fait
 * que masquer les groupes qui ne concernent pas la famille choisie. C'est ce
 * qui permet à la qualification fine d'exister sans dépendre du script, et à
 * DCB de recevoir « Portails métalliques · Portails coulissants » plutôt que
 * « métallerie ».
 *
 * Aucune clé, aucun jeton : l'adresse publique du formulaire DCB est déjà
 * exposée par le site DCB, et rien d'autre ne quitte le navigateur.
 */
import Btn from './Btn.astro';
import { SITE, areaServed } from '../data/site';
import { FAMILIES } from '../data/catalogue';
import { localePath, type Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Famille présélectionnée — employée sur les pages de famille. */
  family?: string | undefined;
}

const { locale, family } = Astro.props;
const { entry, action, packValue, servicePrefix } = SITE.leadForm;

const ECHEANCES = ['deadlineAsap', 'deadline1to3', 'deadline3to6', 'deadlineUnsure'] as const;
---

<form
  class="tp-form"
  id="tp-projet"
  method="post"
  action={action}
  data-lead-form
  data-service-prefix={servicePrefix}
  data-entry-name={entry.name}
  data-entry-email={entry.email}
  data-entry-phone={entry.phone}
  data-entry-service={entry.service}
  data-entry-pack={entry.pack}
  data-entry-details={entry.details}
  data-action={action}
  data-whatsapp={SITE.contact.whatsappHref}
  data-phone={SITE.contact.phoneDisplay}
  data-phone-href={SITE.contact.phoneHref}
  data-locale={locale}
  data-msg-sending={ui('formSending', locale)}
  data-msg-failed={ui('formFailed', locale)}
  data-msg-one={ui('formCountOne', locale)}
  data-msg-many={ui('formCountMany', locale)}
  data-msg-wa={ui('formFallbackWhatsapp', locale)}
  data-msg-call={ui('formFallbackCall', locale)}
  data-msg-intro={ui('formWhatsappIntro', locale)}
  data-msg-consent={ui('consentLine', locale)}
>
  <div class="tp-summary" id="tp-form-erreurs" role="alert" tabindex="-1">
    <h3>{ui('formErrorsTitle', locale)}</h3>
    <ul></ul>
  </div>

  <input type="hidden" name={entry.pack} value={packValue} />

  <div class="tp-form__grid">
    <p class="tp-field">
      <label for="tp-nom">{ui('formName', locale)}</label>
      <input
        class="tp-input"
        type="text"
        id="tp-nom"
        name={entry.name}
        autocomplete="name"
        maxlength="80"
        required
        aria-describedby="tp-nom-err"
      />
      <span class="tp-error" id="tp-nom-err" data-message={ui('errName', locale)}></span>
    </p>

    <p class="tp-field">
      <label for="tp-tel">{ui('formPhone', locale)}</label>
      <input
        class="tp-input tp-ltr"
        type="tel"
        id="tp-tel"
        name={entry.phone}
        autocomplete="tel"
        inputmode="tel"
        maxlength="24"
        required
        aria-describedby="tp-tel-hint tp-tel-err"
      />
      <span class="tp-field__hint" id="tp-tel-hint">{ui('formPhoneHint', locale)}</span>
      <span class="tp-error" id="tp-tel-err" data-message={ui('errPhone', locale)}></span>
    </p>

    <p class="tp-field">
      <label for="tp-ville">{ui('formCity', locale)}</label>
      <input
        class="tp-input"
        type="text"
        id="tp-ville"
        name="tp-ville"
        list="tp-villes"
        autocomplete="address-level2"
        maxlength="60"
        required
        aria-describedby="tp-ville-err"
      />
      <datalist id="tp-villes">
        {areaServed(locale).map((ville) => <option value={ville}></option>)}
      </datalist>
      <span class="tp-error" id="tp-ville-err" data-message={ui('errCity', locale)}></span>
    </p>

    <p class="tp-field">
      <label for="tp-email"
        >{ui('formEmail', locale)} <span class="tp-field__optional">{ui('formOptional', locale)}</span></label
      >
      <input
        class="tp-input tp-ltr"
        type="email"
        id="tp-email"
        name={entry.email}
        autocomplete="email"
        maxlength="120"
        aria-describedby="tp-email-err"
      />
      <span class="tp-error" id="tp-email-err" data-message={ui('errEmail', locale)}></span>
    </p>

    <p class="tp-field">
      <label for="tp-famille">{ui('formFamily', locale)}</label>
      <select class="tp-select" id="tp-famille" name="tp-famille" required aria-describedby="tp-famille-err">
        <option value="">{ui('formChoose', locale)}</option>
        {
          FAMILIES.map((f) => (
            <option value={f.key} selected={family === f.key ? true : undefined}>
              {f.nom[locale]}
            </option>
          ))
        }
        <option value="indecis">{ui('familyUnsure', locale)}</option>
      </select>
      <span class="tp-error" id="tp-famille-err" data-message={ui('errFamily', locale)}></span>
    </p>

    <p class="tp-field">
      <label for="tp-ouvrage">{ui('formProduct', locale)}</label>
      <select class="tp-select" id="tp-ouvrage" name="tp-ouvrage" required aria-describedby="tp-ouvrage-hint tp-ouvrage-err">
        <option value="">{ui('formChoose', locale)}</option>
        {
          FAMILIES.map((f) => (
            <optgroup label={f.nom[locale]} data-famille={f.key}>
              {f.products.map((product) => (
                <option value={product.nom[locale]}>{product.nom[locale]}</option>
              ))}
            </optgroup>
          ))
        }
        <optgroup label="—" data-famille="*">
          <option value={ui('productOther', locale)}>{ui('productOther', locale)}</option>
        </optgroup>
      </select>
      <span class="tp-field__hint" id="tp-ouvrage-hint">{ui('formProductHint', locale)}</span>
      <span class="tp-error" id="tp-ouvrage-err" data-message={ui('errProduct', locale)}></span>
    </p>

    <p class="tp-field">
      <label for="tp-dimensions">{ui('formDimensions', locale)}</label>
      <input
        class="tp-input"
        type="text"
        id="tp-dimensions"
        name="tp-dimensions"
        maxlength="60"
        required
        placeholder={ui('formDimensionsPlaceholder', locale)}
        aria-describedby="tp-dimensions-hint tp-dimensions-err"
      />
      <span class="tp-field__hint" id="tp-dimensions-hint">{ui('formDimensionsHint', locale)}</span>
      <span class="tp-error" id="tp-dimensions-err" data-message={ui('errDimensions', locale)}></span>
    </p>

    <p class="tp-field">
      <label for="tp-echeance"
        >{ui('formDeadline', locale)} <span class="tp-field__optional">{ui('formOptional', locale)}</span></label
      >
      <select class="tp-select" id="tp-echeance" name="tp-echeance">
        <option value="">{ui('formChoose', locale)}</option>
        {ECHEANCES.map((key) => <option value={ui(key, locale)}>{ui(key, locale)}</option>)}
      </select>
    </p>

    <p class="tp-field tp-field--full">
      <label for="tp-message">{ui('formMessage', locale)}</label>
      <textarea
        class="tp-textarea"
        id="tp-message"
        name={entry.details}
        rows="5"
        maxlength="2000"
        required
        aria-describedby="tp-message-hint tp-message-err"></textarea>
      <span class="tp-field__hint" id="tp-message-hint">{ui('formMessageHint', locale)}</span>
      <span class="tp-error" id="tp-message-err" data-message={ui('errMessage', locale)}></span>
    </p>
  </div>

  <div class="tp-consent">
    <input type="checkbox" id="tp-consent" name="tp-consent" value="oui" required aria-describedby="tp-consent-err" />
    <label for="tp-consent">
      {ui('formConsent', locale)}
      <a href={localePath('/politique-confidentialite/', locale)}>{ui('formPrivacyLink', locale)}</a>.
      <span
        class="tp-error"
        id="tp-consent-err"
        data-message={ui('errConsent', locale)}
        data-label={ui('consentShort', locale)}></span>
    </label>
  </div>

  <div class="tp-actions">
    <Btn type="submit" submitHook>{ui('ctaSend', locale)}</Btn>
  </div>

  <p class="tp-status" data-status role="status" aria-live="polite"></p>
</form>

<div class="tp-sent" id="tp-envoye" tabindex="-1" hidden data-sent-panel>
  <h3>{ui('formSentTitle', locale)}</h3>
  <p>{ui('formSentText', locale)} {SITE.responsePromise[locale]}.</p>
  <p class="tp-text-soft">
    {ui('formSentFallback', locale)}
    <a href={SITE.contact.phoneHref} class="tp-ltr">{SITE.contact.phoneDisplay}</a>.
  </p>
</div>
