---
/**
 * Le déroulé — les cinq temps d'un ouvrage, traversés horizontalement.
 * ====================================================================
 *
 * POURQUOI HORIZONTALE, ET POURQUOI ICI
 * Ce que la page AFFIRMAIT sans jamais le montrer, c'est son propre procédé.
 * Cette bande est ce bloc, rendu à ses preuves : le relevé tracé sur le site,
 * les éléments préparés avant le départ, le levage, puis l'usage. Ce ne sont
 * pas des illustrations, c'est une chronologie — et l'axe horizontal devient
 * le temps.
 *
 * CINQ TEMPS, PLUS QUATRE
 * Le parcours confirmé par le client le 1er septembre 2026 en compte cinq :
 * conception, fabrication, finition, livraison, pose. La bande n'en montre que
 * quatre — ceux dont il existe une photographie authentique — et nomme le
 * cinquième, « Utiliser », qui n'est pas une étape de production mais ce à
 * quoi tout le reste sert. Le parcours complet est écrit en toutes lettres sur
 * chaque page de famille, où il n'a pas besoin d'images.
 *
 * LE RYTHME
 * `data-scene-slots="4"` fait TENIR chaque temps avant de rejoindre le suivant.
 * Sans cela, une bande horizontale n'est qu'un travelling : on la traverse sans
 * jamais rien lire. Le moteur publie en retour l'index atteint dans
 * `data-slot`, ce qui allume le repère correspondant.
 *
 * REPLI
 * Sous 62 rem et sous `prefers-reduced-motion`, la scène se dépingle et la
 * piste redevient une liste verticale ordinaire : même texte, mêmes
 * photographies, même ordre. Rien n'est réservé au mouvement.
 */
import Shot from './Shot.astro';
import type { ImageMetadata } from 'astro';
import type { Bilingual, Locale } from '../i18n/locales';

import releve from '../assets/photos/derived/etude-relevee-sur-site.jpg';
import elements from '../assets/photos/derived/ensemble-lames-avant-pose.jpg';
import pose from '../assets/photos/derived/pose-couverture-bord-de-piscine.jpg';
import usage from '../assets/photos/derived/pergola-lames-terrasse-repas-piscine.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

interface Temps {
  readonly index: string;
  readonly titre: Bilingual;
  /** Ce que montre l'image, en deux mots — le sous-titre du temps. */
  readonly piece: Bilingual;
  readonly texte: Bilingual;
  readonly photo: ImageMetadata;
  readonly alt: Bilingual;
  readonly ratio: '4-3' | '3-4' | '3-2' | '1-1' | '16-9';
}

const TEMPS: readonly Temps[] = [
  {
    index: '01',
    titre: { fr: 'Concevoir', ar: 'التصميم' },
    piece: { fr: 'Le relevé', ar: 'رفع القياسات' },
    texte: {
      fr: 'Lire le lieu avant de dessiner : l’orientation, les usages déjà là, ce que la lumière fait au fil de la journée, et l’architecture à laquelle l’ouvrage devra répondre. Le tracé se fait sur le site existant, pas sur un modèle.',
      ar: 'قراءة المكان قبل الرسم: الاتجاه، والاستعمالات القائمة، وما يفعله الضوء على مدار اليوم، والعمارة التي يجب أن يستجيب لها الشغل. يقع التخطيط على الموقع القائم لا على نموذج جاهز.'
    },
    photo: releve,
    alt: {
      fr: 'Étude au trait tracée par-dessus une photographie du site existant, montrant l’implantation de la structure et les cotes relevées.',
      ar: 'دراسة بالخطّ مرسومة فوق صورة للموقع القائم، تُظهر موضع الهيكل والأبعاد المرفوعة.'
    },
    ratio: '16-9'
  },
  {
    index: '02',
    titre: { fr: 'Fabriquer', ar: 'التصنيع' },
    piece: { fr: 'Les éléments', ar: 'القطع' },
    texte: {
      fr: 'Préparer la solution retenue avec les éléments de structure, de remplissage et de finition prévus pour ce projet précis. Ce qui arrive sur le chantier a déjà été assemblé une fois.',
      ar: 'تحضير الحلّ المعتمد بقطع الهيكل والحشو والتشطيب المخصّصة لهذا المشروع بعينه. فما يصل إلى الورشة يكون قد رُكّب مرّة من قبل.'
    },
    photo: elements,
    alt: {
      fr: 'Ensemble de lames claires assemblé à plat au sol dans un local, rayonnages et matériel rangés à l’arrière-plan.',
      ar: 'مجموعة شرائح فاتحة مركّبة مسطّحة على أرض محلّ، ورفوف ومعدّات مرتّبة في الخلفية.'
    },
    ratio: '3-4'
  },
  {
    index: '03',
    titre: { fr: 'Poser', ar: 'التركيب' },
    piece: { fr: 'Le chantier', ar: 'الورشة' },
    texte: {
      fr: 'Monter l’ouvrage sur site, avec les moyens que le lieu impose — accès, levage, et un environnement souvent déjà fini qu’il faut laisser intact.',
      ar: 'تركيب الشغل في الموقع بالوسائل التي يفرضها المكان — المدخل، والرفع، ومحيط غالبًا ما يكون منتهيًا ويجب تركه سليمًا.'
    },
    photo: pose,
    alt: {
      fr: 'Pose d’une couverture sombre à sous-face bois au bord d’une piscine, engin de levage et ouvriers sur la structure.',
      ar: 'تركيب تغطية داكنة بسطح سفلي خشبي على حافّة مسبح، برافعة وعمّال فوق الهيكل.'
    },
    ratio: '3-4'
  },
  {
    index: '04',
    titre: { fr: 'Utiliser', ar: 'الاستعمال' },
    piece: { fr: 'L’ouvrage', ar: 'الشغل' },
    texte: {
      fr: 'C’est là que le projet se juge : non pas à l’ouvrage, mais au temps qu’on passe avec. Un déjeuner qui s’étire, une entrée qui protège vraiment, un escalier qu’on monte sans y penser.',
      ar: 'هنا يُحكَم على المشروع: لا بالشغل نفسه، بل بالوقت الذي يُقضى معه. غداء يطول، ومدخل يحمي فعلًا، وسلّم يُصعَد دون تفكير.'
    },
    photo: usage,
    alt: {
      fr: 'Pergola à lames au-dessus d’une longue table et d’un salon d’extérieur, piscine à gauche et jardin en pente à l’arrière-plan.',
      ar: 'برغولا بشرائح فوق طاولة طويلة وصالون خارجي، ومسبح على اليسار وحديقة منحدرة في الخلفية.'
    },
    ratio: '4-3'
  }
];

const HEAD: Bilingual = {
  fr: 'Le déroulé',
  ar: 'المسار'
};
const LEDE: Bilingual = {
  fr: 'D’un relevé à un ouvrage posé.',
  ar: 'من رفع القياسات إلى شغل مركّب.'
};
---

<section
  class="tp-story tp-light"
  data-scene="pin"
  data-scene-slots={String(TEMPS.length)}
  aria-labelledby="tp-deroule"
>
  <div class="tp-story__stage">
    <div class="tp-shell tp-story__head">
      <p class="tp-eyebrow">{HEAD[locale]}</p>
      <h2 class="tp-story__lede" id="tp-deroule">{LEDE[locale]}</h2>
    </div>

    <div class="tp-story__viewport">
      <ol class="tp-story__track" role="list">
        {
          TEMPS.map((temps) => (
            <li class="tp-story__temps">
              <div class="tp-shell tp-story__grid">
                <div class="tp-story__texte">
                  <p class="tp-story__n">{temps.index}</p>
                  <h3 class="tp-story__titre">{temps.titre[locale]}</h3>
                  <p class="tp-story__piece">{temps.piece[locale]}</p>
                  <p class="tp-text-soft">{temps.texte[locale]}</p>
                </div>

                <div class="tp-story__vue">
                  <Shot photo={temps.photo} alt={temps.alt[locale]} ratio={temps.ratio} format="half" />
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    {/* Le repère du temps atteint. Il double la piste sans la commander :
        `data-slot` vient du moteur, et sans JavaScript aucun repère n'est
        allumé — ce qui reste un état parfaitement lisible. */}
    <div class="tp-shell tp-story__rail" aria-hidden="true">
      {TEMPS.map((temps) => <span class="tp-story__marque">{temps.index}</span>)}
    </div>
  </div>
</section>
