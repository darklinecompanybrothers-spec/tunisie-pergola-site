---
/**
 * Gabarit unique du site, dans les deux langues.
 *
 * `lang` et `dir` sont portés par `<html>` : tout le reste du site n'utilise
 * que des propriétés logiques (`margin-inline`, `inset-inline-start`,
 * `padding-block`), donc la mise en page se retourne d'elle-même en arabe. Il
 * n'existe pas de feuille RTL séparée — seulement quelques règles nommées, là
 * où un geste a un sens physique que la logique ne devine pas (une flèche, une
 * lame, un logo qui ne doit jamais être miroité).
 *
 * L'ouverture — le monogramme qui se construit pièce par pièce sur fond
 * anthracite — n'est posée que sur l'accueil. Son mécanisme est décrit dans
 * `scenes.css` : l'état écrit par défaut est « absent », l'animation part de
 * l'état couvert et y revient sans `animation-fill-mode`. Si les animations ne
 * s'exécutent pas — moteur ancien, réduction de mouvement, JavaScript coupé —
 * le rideau n'apparaît jamais et ne peut donc jamais rester devant le contenu.
 */
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Mark from '../components/brand/Mark.astro';
import Wordmark from '../components/brand/Wordmark.astro';
import type { RoutePath } from '../data/pages';
import { LOCALE_INFO, type Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import '../styles/app.css';

interface Props {
  route: RoutePath;
  locale: Locale;
  shareImage?: string | undefined;
  /** Scène d'ouverture — accueil uniquement. */
  curtain?: boolean | undefined;
  /** Nœuds JSON-LD propres à la page. */
  graph?: readonly object[] | undefined;
}

const { route, locale, shareImage, curtain = false, graph } = Astro.props;
const info = LOCALE_INFO[locale];
---

<!doctype html>
<html lang={info.htmlLang} dir={info.dir}>
  <head>
    <Seo route={route} locale={locale} shareImage={shareImage} graph={graph} />
  </head>
  <body class="tp-light">
    <a class="tp-skip" href="#tp-main">{ui('skip', locale)}</a>

    {
      curtain && (
        <div class="tp-curtain" aria-hidden="true">
          <Mark class="tp-curtain__mark" variant="color" parts />
          <Wordmark class="tp-curtain__word" />
        </div>
      )
    }

    <SiteHeader route={route} locale={locale} />

    <main id="tp-main">
      <slot />
    </main>

    <SiteFooter locale={locale} />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
