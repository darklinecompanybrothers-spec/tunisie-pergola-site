---
/**
 * Accueil — le récit complet.
 *
 * Une seule idée le tient : l'ombre prend forme. Le monogramme est une
 * pergola; il ouvre la page à l'échelle d'une structure réelle, se démonte
 * pendant la descente pour devenir la charpente des scènes suivantes, et se
 * recompose au-dessus du formulaire. Toutes ces transformations sont des
 * fonctions de la progression du défilement : remonter les défait exactement.
 */
import Base from '../layouts/Base.astro';
import Mark from '../components/brand/Mark.astro';
import Shutter from '../components/Shutter.astro';
import Btn from '../components/Btn.astro';
import Shot from '../components/Shot.astro';
import Families from '../components/Families.astro';
import Story from '../components/Story.astro';
import River from '../components/River.astro';
import LeadForm from '../components/LeadForm.astro';
import ContactChannels from '../components/ContactChannels.astro';
import { SITE } from '../data/site';
import { Picture } from 'astro:assets';

/**
 * Image d'ouverture. Visuel d'ambiance fourni par le client, hors portfolio :
 * il habille le premier écran, il ne prétend pas montrer un chantier livré, et
 * il n'entre donc ni dans la galerie ni dans le nombre annoncé sur
 * `/realisations/`. Voir `HORS_PORTFOLIO` dans `photos.catalogue.mjs`.
 */
import heroPhoto from '../assets/photos/derived/hero-pergola-lames-terrasse-piscine-crepuscule.jpg';
import chantierPhoto from '../assets/photos/derived/grande-structure-claire-vue-large.jpg';

---

<Base route="/" curtain>
  <!-- ====================================================================
       1 · Hero — le monogramme à l'échelle d'une structure
       ==================================================================== -->
  <section class="tp-hero" data-scene="pin" aria-labelledby="tp-hero-titre">
    <div class="tp-hero__stage tp-dark">
      <div class="tp-hero__light">
        <Picture
          src={heroPhoto}
          alt="Pergola à lames sombres au-dessus d’une terrasse de piscine à débordement au crépuscule, oliviers, mur en pierre et vallée en contrebas."
          widths={[640, 960, 1280, 1600]}
          sizes="100vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          quality={70}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </div>

      <Shutter role="veil" />

      <Mark class="tp-hero__mark tp-markwork" variant="color" parts />

      <div class="tp-shell tp-hero__copy">
        <p class="tp-eyebrow">Conception · Fourniture · Pose</p>
        <h1 class="tp-hero__title" id="tp-hero-titre">
          Des espaces extérieurs qui changent la façon de <em>vivre</em>.
        </h1>
        <p class="tp-hero__lede">
          Pergolas, verrières et abris pensés pour prolonger les usages d’une maison ou d’un lieu
          professionnel. De {SITE.address.city} à plusieurs régions de Tunisie, chaque contrainte
          d’espace devient une structure claire, utile et durable dans son expression.
        </p>
        <div class="tp-actions">
          <Btn href="/contact/">Parler de votre projet</Btn>
          <Btn href="/realisations/" tone="ghost">Voir les réalisations</Btn>
        </div>
      </div>

      <div class="tp-shell tp-hero__foot">
        <p class="tp-hero__cue">Défiler</p>
        <dl class="tp-hero__ledger">
          <div>
            <dt>Implantation</dt>
            <dd>{SITE.address.city}, {SITE.address.country}</dd>
          </div>
          <div>
            <dt>Interventions</dt>
            <dd>
              <a href="/zones-intervention/">{SITE.areaServed.length} villes déclarées</a>
            </dd>
          </div>
          <div>
            <dt>Demande de projet</dt>
            <dd>{SITE.responsePromise}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       2 · Manifeste — la scène claire arrive par les lames
       ==================================================================== -->
  <section
    class="tp-scene tp-manifesto tp-light tp-scene--seamed"
    data-scene="through"
    aria-labelledby="tp-manifeste"
  >
    <Shutter role="seam" />
    <span class="tp-manifesto__slats" aria-hidden="true"></span>

    <div class="tp-shell">
      <h2 class="tp-manifesto__title" id="tp-manifeste">
        <span class="tp-mask">L’ombre</span>
        <span class="tp-mask">prend</span>
        <span class="tp-mask"><em>forme.</em></span>
      </h2>

      <div class="tp-manifesto__body">
        <p class="tp-lede tp-reveal">
          Une structure bien posée ne se remarque pas tout de suite. On remarque d’abord qu’on reste
          dehors plus longtemps.
        </p>
        <div class="tp-prose tp-reveal">
          <p>
            Un déjeuner qui s’étire. Une entrée qui protège vraiment. Un bord de piscine qui devient
            une pièce de la maison. Ce déplacement d’usage est le vrai sujet : la structure n’est que
            le moyen de l’obtenir.
          </p>
          <p>
            C’est pour cela que chaque projet commence par le lieu — sa forme, son orientation, ce
            qu’on y fait déjà — et non par un modèle choisi dans une liste.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================
       3 · L'approche — le chantier prend toute la largeur
       ==================================================================== -->
  <section class="tp-scene tp-light tp-scene--ruled" aria-labelledby="tp-approche">
    <div class="tp-shell tp-stack tp-stack--lg">
      <div class="tp-grid">
        <div class="tp-stack tp-span-lede">
          <p class="tp-eyebrow tp-reveal">L’approche</p>
          <h2 class="tp-mask" id="tp-approche">Partir du lieu, pas du catalogue.</h2>
        </div>
        <div class="tp-prose tp-reveal tp-span-body">
          <p>
            {SITE.name} conçoit, fournit et installe des structures qui donnent une nouvelle fonction
            aux espaces extérieurs. Terrasse, jardin, entrée, rooftop ou bord de piscine : chaque
            projet part du lieu, de ses usages et de sa lumière pour créer un abri cohérent avec
            l’architecture existante.
          </p>
          <p>
            Basée à {SITE.address.city}, l’entreprise intervient dans plusieurs régions de Tunisie
            pour des pergolas, des verrières, des abris et des abris de jardin. Son portfolio montre
            aussi bien les lignes finales que le travail de pose, afin de rendre visible ce qui
            transforme une idée en espace réellement utilisé.
          </p>
          <p>
            <Btn href="/a-propos/" tone="quiet">Comment nous travaillons</Btn>
          </p>
        </div>
      </div>
    </div>

    <div class="tp-bleed tp-grow tp-reveal" data-scene="enter">
      <Shot
        photo={chantierPhoto}
        alt="Grande structure claire en cours de pose au-dessus d’une cour, vue large horizontale montrant toute la portée."
        legende="Grande structure claire en cours de pose, vue large."
        ratio="21-9"
        format="full"
      />
    </div>

  </section>

  <!-- ====================================================================
       3 bis · Le déroulé — les quatre temps, traversés horizontalement
       ====================================================================
       Ce bloc REMPLACE les trois colonnes de texte qui énonçaient le procédé
       sans jamais le montrer. Même contenu, plus ses preuves : le relevé, les
       éléments préparés, le levage, l'usage. -->
  <Story />

  <!-- ====================================================================
       4 · Trois familles — baie fixe, noms et images qui défilent
       ==================================================================== -->
  <Families />

  <!-- ====================================================================
       5 · Réalisations — le flux traverse le titre
       ==================================================================== -->
  <section class="tp-flow tp-dark" data-scene="pin" aria-labelledby="tp-realisations">
    <div class="tp-flow__stage">
      <div class="tp-shell tp-flow__title">
        <p class="tp-eyebrow">Réalisations</p>
        <h2 id="tp-realisations">Ce qui a été posé, et comment.</h2>
        <p class="tp-lede">
          Structures terminées, détails de sous-face et étapes de pose. Les légendes disent
          uniquement ce que montre la photographie.
        </p>
      </div>

      <River limit={18} />
    </div>
  </section>

  <section class="tp-scene tp-scene--tight tp-dark">
    <div class="tp-shell">
      <Btn href="/realisations/" tone="quiet">Toutes les réalisations</Btn>
    </div>
  </section>

  <!-- ====================================================================
       6 · Zones d'intervention
       ==================================================================== -->
  <section class="tp-scene tp-dark" aria-labelledby="tp-zones">
    <div class="tp-shell tp-stack tp-stack--lg">
      <div class="tp-grid">
        <div class="tp-stack tp-span-lede">
          <p class="tp-eyebrow">Zones d’intervention</p>
          <h2 class="tp-mask" id="tp-zones">Depuis {SITE.address.city}.</h2>
        </div>
        <p class="tp-lede tp-reveal tp-span-body">
          Les villes ci-dessous sont celles que {SITE.name} déclare desservir. Si la vôtre n’y figure
          pas, la question mérite d’être posée directement.
        </p>
      </div>

      <ul class="tp-zones tp-stagger">
        {SITE.areaServed.map((ville) => <li class="tp-reveal">{ville}</li>)}
      </ul>

      <p><Btn href="/zones-intervention/" tone="quiet">Détail des zones</Btn></p>
    </div>
  </section>

  <!-- ====================================================================
       7 · Conversion — le monogramme se recompose au-dessus du formulaire
       ==================================================================== -->
  <section
    class="tp-scene tp-dark tp-convert"
    id="projet"
    data-scene="through"
    aria-labelledby="tp-conversion"
  >
    <div class="tp-convert__roof" aria-hidden="true"><span></span></div>

    <div class="tp-shell tp-stack tp-stack--lg">
      <div class="tp-cta">
        <div class="tp-stack">
          <p class="tp-eyebrow">Votre projet</p>
          <h2 class="tp-cta__title tp-mask" id="tp-conversion">
            Votre espace mérite une réponse précise.
          </h2>
          <p class="tp-lede">
            Décrivez le lieu, les dimensions approximatives et l’usage recherché. L’équipe chargée du
            suivi commercial vous répond sous 24 heures.
          </p>
        </div>

        <ContactChannels />
      </div>

      <LeadForm />
    </div>
  </section>
</Base>
