---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Gallery from '../components/Gallery.astro';
import Shot from '../components/Shot.astro';
import { SITE } from '../data/site';

import pergolaPhoto from '../assets/photos/derived/pergola-adossee-lames-terrasse-repas.jpg';
import headPhoto from '../assets/photos/derived/pergola-lames-rooftop-terrasse-bois.jpg';

/**
 * Typologies visibles dans le portfolio public : comment la structure prend
 * appui, et rien d'autre. C'est un axe indépendant des GAMMES, qui disent de
 * quoi la couverture est faite et viennent, elles, de `SITE.ranges`.
 *
 * Toujours interdits ici, faute de documentation : l'étanchéité, la résistance
 * au vent, toute performance chiffrée, et le quatrième produit motorisé évoqué
 * par le client sans intitulé établi.
 */
const TYPOLOGIES = [
  {
    titre: 'Adossée',
    texte:
      'La structure prend appui sur la façade et prolonge la maison vers l’extérieur. C’est la réponse la plus fréquente pour une terrasse de repas attenante au séjour.',
    observe: 'Observée sur les réalisations publiées : terrasse repas sous lames claires.'
  },
  {
    titre: 'Indépendante',
    texte:
      'La structure tient sur ses propres poteaux, sans contact avec le bâti. Elle permet de poser un espace couvert là où aucune façade ne peut servir d’appui.',
    observe: 'Observée sur les réalisations publiées : pergola à deux travées sur terrasse en hauteur.'
  },
  {
    titre: 'Bord de piscine et rooftop',
    texte:
      'Même principe, contraintes différentes : accès, levage, et une structure qui doit tenir dans un environnement déjà fini.',
    observe: 'Observée sur les réalisations publiées : pose d’une couverture au bord d’une piscine.'
  }
];
---

<Base route="/pergolas/">
  <PageHead
    route="/pergolas/"
    eyebrow="Service"
    title="Pergolas adossées et indépendantes."
    lede="Des structures pour redéfinir terrasses, jardins, rooftops et abords de piscine — conçues à partir du lieu, fournies et posées par la même équipe."
    theme="slats"
    photo={headPhoto}
    photoAlt="Pergola anthracite indépendante à deux travées, lames et éléments latéraux, installée sur une terrasse en hauteur."
  />

  <section class="tp-scene tp-light" aria-labelledby="tp-pergola-intro">
    <div class="tp-shell tp-grid">
      <div class="tp-stack tp-span-lede">
        <p class="tp-eyebrow">Ce que c’est</p>
        <h2 class="tp-mask" id="tp-pergola-intro">Une pièce en plus, dehors.</h2>
      </div>
      <div class="tp-prose tp-reveal tp-span-body">
        <p>
          Une pergola change la manière d’occuper un extérieur. Elle délimite un endroit où l’on
          s’installe, elle apporte de l’ombre là où il n’y en avait pas, et elle donne à une terrasse
          la présence d’une véritable pièce.
        </p>
        <p>
          {SITE.name} traite le projet de bout en bout : lecture du lieu, conception de la structure,
          fourniture des éléments et pose sur site.
        </p>
      </div>
    </div>
  </section>

  <section class="tp-scene tp-scene--flush-top tp-light">
    <div class="tp-bleed tp-grow tp-reveal" data-scene="enter">
      <Shot
        photo={pergolaPhoto}
        alt="Pergola anthracite adossée à une maison, lames claires vues par en dessous, au-dessus d’une terrasse repas."
        legende="Pergola anthracite adossée avec lames claires au-dessus d’une terrasse repas."
        ratio="21-9"
        format="full"
      />
    </div>
  </section>

  <section class="tp-scene tp-dark" aria-labelledby="tp-typologies">
    <div class="tp-shell tp-stack tp-stack--lg">
      <div class="tp-grid">
        <div class="tp-stack tp-span-lede">
          <p class="tp-eyebrow">Typologies</p>
          <h2 class="tp-mask" id="tp-typologies">Trois configurations, vues sur les chantiers.</h2>
        </div>
        <p class="tp-lede tp-reveal tp-span-body">
          Les configurations ci-dessous sont celles que montrent les réalisations publiées. La
          configuration retenue pour un projet dépend du lieu, pas d’un catalogue.
        </p>
      </div>

      <ol class="tp-cols tp-stagger" role="list">
        {
          TYPOLOGIES.map((item, index) => (
            <li class="tp-stack tp-reveal">
              <p class="tp-index">{String(index + 1).padStart(2, '0')}</p>
              <h3>{item.titre}</h3>
              <p class="tp-text-soft">{item.texte}</p>
              <p class="tp-text-soft">
                <small>{item.observe}</small>
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Les gammes disent de quoi la couverture est faite — un axe indépendant de
      la typologie ci-dessus, qui dit comment la structure prend appui. Elles
      viennent de `SITE.ranges`, c'est-à-dire du relevé de vive voix du client
      (CLIENT-BRIEF §2 bis) et de nulle part ailleurs. */}
  <section class="tp-scene tp-light" aria-labelledby="tp-gammes">
    <div class="tp-shell tp-stack tp-stack--lg">
      <div class="tp-grid">
        <div class="tp-stack tp-span-lede">
          <p class="tp-eyebrow">Gammes</p>
          <h2 class="tp-mask" id="tp-gammes">Trois façons de couvrir.</h2>
        </div>
        <p class="tp-lede tp-reveal tp-span-body">
          La typologie dit où la structure prend appui. La gamme dit ce qui vous sépare du ciel — et
          c’est elle qui décide de ce que vous pourrez faire sous la structure, et quand.
        </p>
      </div>

      <ol class="tp-cols tp-stagger" role="list">
        {
          SITE.ranges.map((gamme, index) => (
            <li class="tp-stack tp-reveal">
              <p class="tp-index">{String(index + 1).padStart(2, '0')}</p>
              <h3>{gamme.nom}</h3>
              <p class="tp-accent">{gamme.resume}</p>
              <p class="tp-text-soft">{gamme.detail}</p>
            </li>
          ))
        }
      </ol>

      <p class="tp-text-soft tp-reveal">
        <small>
          Le choix se tranche sur place, pas sur une page : {SITE.delay.phrase}
        </small>
      </p>
    </div>
  </section>

  <section class="tp-scene tp-light" aria-labelledby="tp-pergola-galerie">
    <div class="tp-shell tp-stack tp-stack--lg">
      <div class="tp-stack">
        <p class="tp-eyebrow">En situation</p>
        <h2 class="tp-mask" id="tp-pergola-galerie">Pergolas photographiées sur place.</h2>
      </div>

      <Gallery service="pergolas" />

      <p><Btn href="/realisations/" tone="quiet">Toutes les réalisations</Btn></p>
    </div>
  </section>

  <section class="tp-scene tp-scene--tight tp-light" aria-labelledby="tp-pergola-suite">
    <div class="tp-shell tp-grid">
      <div class="tp-stack tp-span-lede">
        <p class="tp-eyebrow">Aussi</p>
        <h2 class="tp-mask" id="tp-pergola-suite">Deux familles voisines.</h2>
      </div>
      <div class="tp-prose tp-reveal tp-span-body">
        <p>
          Un projet ne rentre pas toujours dans la case « pergola ». Selon ce que vous cherchez à
          obtenir, la réponse peut être une <a href="/verrieres/">verrière</a> ou un
          <a href="/abris/">abri</a>.
        </p>
        <p>
          Si votre ville figure parmi les
          <a href="/zones-intervention/">zones d’intervention déclarées</a>, la demande peut être
          traitée directement.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Parlons de votre terrasse."
    text="Le lieu, les dimensions approximatives et l’usage recherché suffisent pour commencer. L’équipe chargée du suivi commercial vous répond sous 24 heures."
  />
</Base>
