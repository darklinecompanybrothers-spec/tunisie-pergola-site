---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Gallery from '../components/Gallery.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';

import headPhoto from '../assets/photos/derived/grande-structure-claire-vue-large.jpg';

const entries = await getCollection('realisations');
---

<Base route="/realisations/">
  <PageHead
    route="/realisations/"
    eyebrow="Réalisations"
    title="Ce qui a été posé, et comment."
    lede="Structures terminées, détails de sous-face et étapes de pose. Les légendes disent uniquement ce que montre la photographie."
    theme="slats"
    photo={headPhoto}
    photoAlt="Grande structure blanche en cours de pose, vue large horizontale sur un chantier."
  />

  <section class="tp-scene tp-light" aria-labelledby="tp-galerie">
    <div class="tp-shell tp-stack tp-stack--lg">
      <h2 class="tp-visually-hidden" id="tp-galerie">Galerie des réalisations</h2>
      <Gallery filtrable eagerFirst />
    </div>
  </section>

  <section class="tp-scene tp-scene--tight tp-dark" aria-labelledby="tp-provenance">
    <div class="tp-shell tp-grid">
      <div class="tp-stack tp-span-lede">
        <p class="tp-eyebrow">Provenance</p>
        <h2 class="tp-mask" id="tp-provenance">D’où viennent ces photos.</h2>
      </div>
      <div class="tp-prose tp-reveal tp-span-body">
        <p>
          Les {entries.length} photographies publiées ici proviennent de la page Facebook de {
            SITE.name
          }, avec l’autorisation de l’entreprise pour ce site. Certaines ont été recadrées pour
          sortir du cadre l’ancien bandeau de contact incrusté sur l’image : aucun élément de
          chantier n’a été effacé, retouché ou ajouté.
        </p>
        <p>
          Les légendes décrivent ce que l’on voit et rien de plus. Ni ville, ni date, ni matériau,
          ni performance ne sont attribués à une photographie tant que la publication d’origine ne
          les confirme pas.
        </p>
        <p>
          <Btn href={SITE.social.facebook} tone="quiet" external>Voir la page Facebook</Btn>
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Un projet proche de l’un de ceux-ci ?"
    text="Décrivez le lieu, les dimensions approximatives et l’usage recherché. L’équipe chargée du suivi commercial vous répond sous 24 heures."
  />
</Base>
