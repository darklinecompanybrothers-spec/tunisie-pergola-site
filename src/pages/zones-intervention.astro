---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactChannels from '../components/ContactChannels.astro';
import { SITE } from '../data/site';

/**
 * Une seule page pour toutes les zones.
 *
 * Aucune page ville n'est générée par permutation : ce serait exactement le
 * schéma de « pages satellites » que Google sanctionne, et surtout il n'y a
 * aujourd'hui aucun contenu propre à chaque ville. Une page locale ne sera
 * créée que le jour où une réalisation identifiée, ses photographies et ses
 * informations vérifiées la rendent utile.
 */
const OBSERVES = SITE.observedProjectPlaces;
---

<Base route="/zones-intervention/">
  <PageHead
    route="/zones-intervention/"
    eyebrow="Zones d’intervention"
    title="Depuis Sousse, vers le reste du pays."
    lede={`${SITE.name} déclare desservir ${SITE.areaServed.length} villes. Son adresse publique est à ${SITE.address.city}.`}
    theme="grid"
  />

  <section class="tp-scene tp-light" aria-labelledby="tp-villes">
    <div class="tp-shell tp-stack tp-stack--lg">
      <div class="tp-grid">
        <div class="tp-stack tp-span-lede">
          <p class="tp-eyebrow">Villes déclarées</p>
          <h2 class="tp-mask" id="tp-villes">Les {SITE.areaServed.length} zones annoncées.</h2>
        </div>
        <p class="tp-lede tp-reveal tp-span-body">
          Cette liste reprend exactement les zones que l’entreprise annonce elle-même. Si votre
          commune n’y figure pas, cela ne veut pas dire non : posez la question.
        </p>
      </div>

      <ul class="tp-zones tp-reveal">
        {SITE.areaServed.map((ville) => <li>{ville}</li>)}
      </ul>
    </div>
  </section>

  <section class="tp-scene tp-dark tp-scene--ruled" aria-labelledby="tp-lieux">
    <div class="tp-shell tp-grid">
      <div class="tp-stack tp-span-lede">
        <p class="tp-eyebrow">Lieux de réalisation</p>
        <h2 class="tp-mask" id="tp-lieux">Trois lieux cités dans les publications.</h2>
      </div>
      <div class="tp-prose tp-reveal tp-span-body">
        <p>
          Les publications publiques de l’entreprise mentionnent des interventions à {
            OBSERVES.slice(0, -1).join(', ')
          } et {OBSERVES[OBSERVES.length - 1]}. Ces lieux sortent de la liste des zones déclarées :
          ils montrent que le rayon réel dépasse parfois l’annonce.
        </p>
        <p>
          Ils ne font pas l’objet de pages dédiées pour l’instant. Une page locale n’a d’intérêt —
          pour un visiteur comme pour un moteur — que si elle porte une réalisation identifiée, ses
          photographies et ses informations propres. Tant que ces éléments ne sont pas vérifiés,
          cette page unique dit la vérité mieux que dix pages recopiées.
        </p>
        <p><Btn href="/realisations/" tone="quiet">Voir les réalisations publiées</Btn></p>
      </div>
    </div>
  </section>

  <section class="tp-scene tp-light" aria-labelledby="tp-comment">
    <div class="tp-shell tp-grid">
      <div class="tp-stack tp-span-lede">
        <p class="tp-eyebrow">Comment ça se passe</p>
        <h2 class="tp-mask" id="tp-comment">Une demande, une réponse.</h2>
        <p class="tp-text-soft">
          Le déplacement, la fourniture et la pose s’organisent après la prise de contact, en
          fonction du lieu et du projet.
        </p>
      </div>

      <div class="tp-stack tp-span-body tp-reveal">
        <dl class="tp-nap">
          <div>
            <dt>Adresse</dt>
            <dd>{SITE.address.inline}</dd>
          </div>
          <div>
            <dt>Téléphone et WhatsApp</dt>
            <dd>
              <a href={SITE.contact.phoneHref} class="tp-tabular" data-track="phone"
                >{SITE.contact.phoneDisplay}</a
              >
            </dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd><a href={SITE.contact.emailHref}>{SITE.contact.email}</a></dd>
          </div>
        </dl>

        <ContactChannels />
      </div>
    </div>
  </section>

  <CtaBand
    title="Votre ville, votre projet."
    text="Indiquez la ville, le lieu, les dimensions approximatives et l’usage recherché. L’équipe chargée du suivi commercial vous répond sous 24 heures."
  />
</Base>
